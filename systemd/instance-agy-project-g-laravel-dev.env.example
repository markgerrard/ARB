# Example per-instance config for agent-bridge@agy-project-g-laravel-dev.service
# Install to: /srv/agent-redis-bridge/envs/instance-agy-project-g-laravel-dev.env
BRIDGE_ENGINE=agy-print
BRIDGE_WORKSPACE=dev
