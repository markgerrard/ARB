# Bridge bus credentials are read from this existing root-readable file.
AGENT_ENV_FILE=/etc/agent-redis-bridge.env
ARB_REGISTRAR_AGENT_ID=arb-seat-registrar
ARB_REGISTRAR_STORE=/var/lib/arb-seat-registrar/registrar.sqlite3

# Full 64-hex operator pubkey. Replies by every other key are ignored.
ARB_REGISTRAR_MARK_PUBKEY=
ARB_REGISTRAR_OPS_CHANNEL=
ARB_REGISTRAR_COMMUNITY_ID=
ARB_REGISTRAR_RELAY_URL=wss://relay.example.invalid
ARB_REGISTRAR_DATABASE_URL=postgresql://
ARB_REGISTRAR_BUZZ_ENV_FILE=/etc/arb-registrar-seat.env

# Optional, default off: Mark's mode-0600 hex or nsec owner key. When present,
# registration profiles carry a kind=0 NIP-OA owner authorization tag.
# ARB_REGISTRAR_OWNER_KEY_FILE=/etc/arb-registrar-owner.key

# Commands are parsed as argv, not evaluated by a shell.
ARB_REGISTRAR_BUZZ_CLI=/usr/local/bin/buzz
ARB_REGISTRAR_BUZZ_ADMIN=docker exec buzz-relay buzz-admin

# The relay identity's BUZZ_PRIVATE_KEY and BUZZ_RELAY_URL live in the separate
# mode-0600 ARB_REGISTRAR_BUZZ_ENV_FILE and are merged only into CLI subprocesses.
