# Example per-instance config for agent-bridge@codex-project-g-laravel-dev.service
# Install to: /srv/agent-redis-bridge/envs/instance-codex-project-g-laravel-dev.env
BRIDGE_ENGINE=codex
BRIDGE_WORKSPACE=dev
# Codex needs the bypass flag to run unattended (no approval prompts / sandbox).
BRIDGE_EXTRA_FLAGS=--codex-bypass-approvals-and-sandbox
# Bridge reads AGENT_ENV_FILE for redis host/port/db, project, workdir,
# trusted senders, dispatch-from. Point it at the shared per-project env.
AGENT_ENV_FILE=/srv/agent-redis-bridge/envs/project-g-laravel-dev.env
