# agent_redis_bridge — host configuration
#
# Copy to your worktree as .env and set the values. Both the bridge
# daemon (`agent_redis_bridge`) and the dispatcher (`scripts/agent-dispatch`)
# read from this file. The systemd wrapper (`scripts/agent-redis-bridge-systemd`)
# also sources the keys below.
#
# A *clone-anywhere* setup needs nothing more than:
#   1. Redis reachable at AGENT_REDIS_HOST:PORT (or default 127.0.0.1:6390)
#   2. This .env populated
#   3. The codex / gemini CLI installed + authed
#   4. The bridge daemon running (systemctl --user start agent-redis-bridge@codex-dev)


# ─── Redis transport ────────────────────────────────────────────────
# Where the bridge bus lives. Both ends of every dispatch read these.
AGENT_REDIS_HOST=127.0.0.1
AGENT_REDIS_PORT=6390
AGENT_REDIS_DB=12
AGENT_REDIS_PREFIX=agent_scratch:
# Optional auth + TLS for managed bus (e.g. DO Valkey). Leave blank for
# local unauthenticated Redis. AGENT_REDIS_TLS=1 enables --tls on every
# redis-cli call; AGENT_REDIS_PASSWORD is exported as REDISCLI_AUTH so
# it does not appear in `ps`.
AGENT_REDIS_TLS=0
AGENT_REDIS_USER=
AGENT_REDIS_PASSWORD=


# ─── Project / workspace identity ───────────────────────────────────
# Together with the engine these determine the bridge's agent_id:
#   {codex|gemini-acp|grok-acp|agy-print}-${AGENT_PROJECT}-${AGENT_WORKSPACE}
# e.g. AGENT_PROJECT=acme + AGENT_WORKSPACE=dev + engine=grok-acp
#      → agent_id "grok-acme-dev"
AGENT_PROJECT=project-c
AGENT_WORKSPACE=dev


# ─── Workdir ────────────────────────────────────────────────────────
# The directory the bridge cd's into when running tasks. Usually the
# application repo this bridge instance is paired with.
AGENT_WORKDIR=/srv/projects/project-c-dev


# ─── Sender policy ──────────────────────────────────────────────────
# Comma-separated allow-list of `agent-id=role` pairs the bridge will
# accept. Roles: trusted (machine peer) | human (cli operator).
# Bridges reject envelopes from any sender NOT on this list.
AGENT_TRUSTED_SENDERS=claude-project-c-dev=trusted,claude-project-c-staging=trusted,human-codexctl=human


# ─── Dispatcher ─────────────────────────────────────────────────────
# Default `from` agent-id the dispatcher uses when FROM_AGENT_ID isn't
# explicitly set in the shell.
AGENT_DISPATCH_FROM=claude-project-c-dev


# ─── Optional ───────────────────────────────────────────────────────

# Per-instance branch label written into every dispatched envelope.
# The bridge uses this for envelope validation (rejects empty branches).
# AGENT_DISPATCH_BRANCH=dev

# Pin a specific Codex model (defaults to the bridge's DEFAULT_CODEX_MODEL).
# AGENT_CODEX_MODEL=gpt-5.5

# Daily caps. 0 means unlimited.
# AGENT_DAILY_REQUEST_LIMIT=100
# AGENT_DAILY_TURN_SECONDS_LIMIT=14400

# Shared usage scope (for impl/rev role pairs that share a budget).
# AGENT_USAGE_SCOPE=codex-project-c-dev-shared
