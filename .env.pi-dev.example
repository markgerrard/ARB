# pi-rpc bridge development example.
#
# For supervised deployments, prefer the env-file driven user service:
#   systemd/agent-bridge@.service
#
# Example manual launches from this repo:
#   PYTHONPATH=src python3 -m agent_redis_bridge --env-file .env.pi-dev --engine pi-rpc --workspace dev
#   PYTHONPATH=src python3 -m agent_redis_bridge --env-file .env.pi-dev --engine pi-rpc --workspace dev --role kimi --model kimi-coding/kimi-k2-thinking --pi-tools read,grep,find,ls
#   PYTHONPATH=src python3 -m agent_redis_bridge --env-file .env.pi-dev --engine pi-rpc --workspace dev --role minimax --model minimax/MiniMax-M3 --pi-tools read,grep,find,ls
#
# For systemd, put the same values in an instance env file and set:
#   BRIDGE_ENGINE=pi-rpc
#   BRIDGE_WORKSPACE=dev
#   BRIDGE_EXTRA_FLAGS=--role kimi --model kimi-coding/kimi-k2-thinking --pi-tools read,grep,find,ls

AGENT_REDIS_HOST=127.0.0.1
AGENT_REDIS_PORT=6390
AGENT_REDIS_DB=12
AGENT_REDIS_PREFIX=agent_scratch:
AGENT_REDIS_TLS=0
AGENT_REDIS_USER=
AGENT_REDIS_PASSWORD=

AGENT_PROJECT=bridge
AGENT_WORKSPACE=dev
AGENT_WORKDIR=/home/<user>/AgentRedisBridge

AGENT_TRUSTED_SENDERS=claude-bridge-dev=trusted,human-codexctl=human
AGENT_DISPATCH_FROM=claude-bridge-dev
AGENT_DISPATCH_BRANCH=main

# Set for read-only review instances. Leave unset for a trusted full-tools worker.
BRIDGE_PI_TOOLS=read,grep,find,ls
