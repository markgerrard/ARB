#!/usr/bin/env python3
"""Alarm when a watched integration ref moves other than by an ordinary push.

The cheapest slice of "option R" in
the remote-observer design note (not included in this repository):
observation without per-tool-call bracketing. It detects; it does not prevent,
and it does not attribute a change to a tool call.

Exit codes are distinct so a broken monitor is not mistaken for a quiet one:

    0  quiet   nothing new on a watched ref, or first run (baseline established)
    1  ALARM   a watched ref moved by something other than an ordinary push
    2  error   the feed could not be read; the cursor is left untouched

Typical use, from cron or launchd:

    scripts/arb-remote-alarm \
        --repo example-org/AgentRedisBridge \
        --state ~/.arb-warm-orch/remote-alarm.json \
        --log   ~/.arb-warm-orch/remote-alarm.jsonl

Needs `gh` authenticated with repo read. Every call is a GET; this never writes
to the remote.
"""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "src"))

from arb_warm_orch.remote_alarm import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
