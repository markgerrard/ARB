#!/usr/bin/env python3
"""arb-orch-panel — roster-driven parallel panel dispatch + vote parse.

Low-context ARB orch helper. Stops orchestrators hand-rolling fragile bash
panel loops (vote-fence `{...}` regex under command substitution breaks;
`jobs -p` hangs under non-interactive bash).

Canonical orch pattern (NEVER model-side poll loops — they waste tokens):

  # Fire panel in its own session; return immediately to the orch turn.
  arb-orch-panel --detach --stage plan --round 3 \
    --artifact /abs/plan.md --repo /abs/git/repo
  # → DETACHED out=<dir> pid=<n>

  # Optional: one background monitor process (not the model) that blocks
  # until summary.json exists, then exits with the gate code. Start via
  # start_new_session / harness background job — do NOT sleep-poll in-model.
  arb-orch-panel --monitor --out-dir <dir>   # blocks; exit 0/1 = PASS/FAIL

  # When the orch turn resumes (user/harness wake), collect once:
  arb-orch-panel --collect --out-dir <dir>

Foreground (only for short/--dry-run or non-interactive shells that can wait):

  arb-orch-panel --stage design --round 1 --artifact … --repo …

Exit codes:
  0  gate PASS (collect/run) or detach started ok / status=done PASS
  1  gate FAIL or runner dead without summary
  2  usage
  3  status/collect: still running (not an error — try again)
"""
from __future__ import annotations

import os
import sys
from pathlib import Path as _Path

# Prefer <workspace> .venv so events-tee can import redis and other project deps.
# System python3 often lacks them; without this, --events-tee silently writes nothing.
# Compare sys.prefix (not resolved executable): venv python is a symlink into
# Homebrew's framework binary, so Path.resolve() falsely looks "already in venv".
_BRIDGE_ROOT = _Path(__file__).resolve().parent.parent
_VENV_PY = _BRIDGE_ROOT / ".venv" / "bin" / "python"
_VENV_PREFIX = (_BRIDGE_ROOT / ".venv").resolve()
_VENV_REEXEC_SENTINEL = "ARB_ORCH_PANEL_VENV_REEXECED"


def _reexec_in_venv_once() -> None:
    if os.environ.pop(_VENV_REEXEC_SENTINEL, None) == "1":
        return
    if not _VENV_PY.is_file() or _Path(sys.prefix).resolve() == _VENV_PREFIX:
        return
    os.environ[_VENV_REEXEC_SENTINEL] = "1"
    try:
        os.execv(str(_VENV_PY), [str(_VENV_PY), str(_Path(__file__).resolve()), *sys.argv[1:]])
    except OSError:
        os.environ.pop(_VENV_REEXEC_SENTINEL, None)


_reexec_in_venv_once()

