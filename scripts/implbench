#!/usr/bin/env python3
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
REPO_PYTHON = ROOT / ".venv" / "bin" / "python"
if Path(sys.executable).resolve() != REPO_PYTHON.resolve():
    if not REPO_PYTHON.is_file() or not os.access(REPO_PYTHON, os.X_OK):
        raise SystemExit(f"implbench requires synced repo Python at {REPO_PYTHON}; run uv sync --extra bench")
    os.execv(str(REPO_PYTHON), [str(REPO_PYTHON), __file__, *sys.argv[1:]])

sys.path.insert(0, str(ROOT / "bench"))
sys.path.insert(0, str(ROOT / "src"))

from implbench.harness.cli import main

raise SystemExit(main())
