#!/usr/bin/env python3
"""Generate docs/INDEX.md from docs/index.json."""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from doc_index_lib import INDEX_MD_PATH, load_entries, render_index


def main() -> int:
    INDEX_MD_PATH.write_text(render_index(load_entries()))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
