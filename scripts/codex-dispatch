#!/usr/bin/env bash
# Legacy alias of agent-dispatch. Kept for back-compat with existing
# systemd units / CI scripts / muscle memory; will be removed in a
# future release. New callers should target agent-dispatch directly.
SCRIPT_DIR="$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
echo "[codex-dispatch] DEPRECATED: use ${SCRIPT_DIR}/agent-dispatch — this alias will be removed in a future release." >&2
exec "${SCRIPT_DIR}/agent-dispatch" "$@"
