WORKER_VANTAGE = "BRIDGE_WORKER_VANTAGE"
CLAIM_GATE = "BRIDGE_CLAIM_GATE"
TASK_REF_REQUIRED = "BRIDGE_TASK_REF_REQUIRED"
GATE_READER_DSN = "ARB_GATE_READER_DSN"
GATE_READER_ROLE = "ARB_GATE_READER_ROLE"
LANE_WRITER_DSN = "ARB_GATE_LANE_WRITER_DSN"
LANE_WRITER_ROLE = "ARB_GATE_LANE_WRITER_ROLE"
LANE_WRITER_CONSUMER = "ARB_GATE_LANE_WRITER_CONSUMER_ID"
LANE_WRITER_LANE = "ARB_GATE_LANE_WRITER_LANE"
WORKTREE_LANE = "BRIDGE_WORKTREE_LANE"

CHECKLIST_MODES = ("claim-gate", "ref-required", "legacy-removal")
TASK_WIRE_DUAL = "legacy-or-ref-v1"
BRIEF_HYDRATE_V1 = "v1"
EVIDENCE_TARGET_REGISTRY = "BRIDGE_PREFLIGHT_TARGET_REGISTRY"
EVIDENCE_SENDER_MIGRATION = "BRIDGE_PREFLIGHT_SENDER_MIGRATION"
