#!/usr/bin/env python3
"""seat-preflight — check seat files and runtime invariants before standup.

Usage:
    scripts/seat-preflight <plist-or-env-path> [--strict]
    scripts/seat-preflight <plist-or-env-path> --checklist {claim-gate|ref-required|legacy-removal} [--strict]

Exit 0 means all checks hold, 1 means a seat violation was found, and 2 means
the command was misused. Warnings are retained by default and become failures
with --strict.

Checklist modes (Slice 1d-vi / Task 7) are operator-owned enablement gates:
they do not flip BRIDGE_CLAIM_GATE or BRIDGE_TASK_REF_REQUIRED; they only prove
prerequisites before an owner sets those flags.
"""
from __future__ import annotations

import os
import json
import plistlib
import re
import shutil
import stat
import subprocess
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path
from urllib.parse import urlparse


_SRC = Path(__file__).resolve().parent.parent / "src"
if str(_SRC) not in sys.path:
    sys.path.insert(0, str(_SRC))
_BENCH = Path(__file__).resolve().parent.parent / "bench"
if str(_BENCH) not in sys.path:
    sys.path.insert(0, str(_BENCH))


