DIRECT_REF_ERROR = "brief_hydration_unavailable"
# bridge.py:513 — exact membership only
WORKTREE_LANE_ALLOWED = frozenset({"gated", "exempt"})
# Keys the bridge reads from process env only (not --env-file).
# Driven by call sites of _process_env_attestation (membership is enforced there).
# ARB_MEMORY_REDIS_URL is deliberately NOT a member: bridge.py resolve_audit_redis
# (bridge.py:205-212) supports process-env OR --env-file fallback.
PROCESS_ENV_ONLY_KEYS = frozenset(
    {
        WORKER_VANTAGE,
        WORKTREE_LANE,
        LANE_WRITER_DSN,
        LOCAL_DSN,
    }
)
MEMORY_REDIS_URL = "ARB_MEMORY_REDIS_URL"
# Legacy-removal observation window floors (documented in deploy/README.md).
LEGACY_WINDOW_MIN_DURATION = timedelta(hours=24)
