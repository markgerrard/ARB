    "kimi-cli": ("Kimi", "openinterpreter", "kimi-for-coding", "k2p7", "kimi-cli", "interpreter-agentredisbridge-bake-k2p7-kimicli", "INTERPRETER_HOME", "BRIDGE_INTERPRETER_RETIRE_AFTER_TURN"),
