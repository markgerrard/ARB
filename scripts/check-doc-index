#!/usr/bin/env python3
"""Validate docs/index.json and generated docs/INDEX.md."""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from doc_index_lib import load_entries, validate_entries


def main() -> int:
    try:
        entries = load_entries()
        errors = validate_entries(entries)
    except Exception as exc:  # noqa: BLE001 - script should print concise failures.
        errors = [str(exc)]
    if errors:
        for error in errors:
            print(f"doc-index: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
