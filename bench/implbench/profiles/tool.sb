(version 1)
(deny default)
(deny mach-lookup)
(deny network-outbound)
(deny network-inbound)
(deny process-exec (literal "/usr/bin/git"))
(deny process-exec (literal "/usr/local/bin/git"))
(deny process-exec (literal "/opt/homebrew/bin/git"))
(deny process-exec (literal "/usr/bin/xcrun"))
(deny network-outbound (remote tcp "127.0.0.1:*"))
(deny network-outbound (remote tcp "[::1]:*"))
