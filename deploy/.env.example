# ARB Memory deploy env — copy to deploy/.env (gitignored) and fill in. NEVER commit deploy/.env.
# Substrate (DO managed):
ARB_MEMORY_DSN=postgresql://<owner>:<pw>@<host>:25060/<db>?sslmode=require
ARB_MEMORY_MCP_DSN=postgresql://<mcp-role>:<pw>@<host>:25060/<db>?sslmode=require
ARB_MEMORY_REDIS_URL=rediss://default:<pw>@<valkey-host>:25061/<db-index>
OPENAI_API_KEY=sk-...
# Public door (must match the tunnel hostname exactly; no trailing slash):
ARB_MEMORY_MCP_PUBLIC_BASE_URL=https://dev-arb-memory.example.com
# Operator auth secrets (you set these):
ARB_MEMORY_MCP_LOGIN_SECRET=<strong-passphrase>
ARB_MEMORY_MCP_TOTP_SECRET=<base32-totp-secret-loaded-into-your-authenticator>
# Cloudflare tunnel token (token model):
TUNNEL_TOKEN=<tunnel-token-from-zero-trust>

# --- Observability planes (eval / transcript / visibility) — least-privilege role DSNs ---
# Each consumer/gateway connects with its OWN role, never the owner above. Provision the roles
# (LOGIN + password) and run the matching apply_*_grants() once as owner — see the deploy runbook.
# These are REQUIRED for the eval/transcript/visibility compose services (fail-loud if unset).
ARB_EVAL_DSN=postgresql://<eval-writer-role>:<pw>@<host>:25060/<db>?sslmode=require        # apply_eval_grants
ARB_TRANSCRIPT_DSN=postgresql://<transcript-writer-role>:<pw>@<host>:25060/<db>?sslmode=require  # apply_transcript_grants
ARB_VISIBILITY_DSN=postgresql://<visibility-read-role>:<pw>@<host>:25060/<db>?sslmode=require    # apply_visibility_grants (SELECT-only)
# The DB role that `arb-memory grants` applies the visibility SELECT grants TO (usually the
# read-role in ARB_VISIBILITY_DSN). If unset, apply_visibility_grants is SKIPPED — the reader
# keeps only its existing grants (fails closed), and `grants` prints a WARNING (audit OPS-V1).
ARB_VISIBILITY_GATEWAY_ROLE=<visibility-read-role>
# The MCP door role `arb-memory grants` targets (README §Secrets). REQUIRED wherever the role
# isn't the default `arbmem_mcp`: a bare `grants` run dies on apply_mcp_grants (UndefinedObject)
# BEFORE reaching the visibility step — bit prod 2026-07-08 (prod role is arbmemory-mcp).
ARB_MEMORY_MCP_ROLE=<mcp-door-role>
# Valkey URLs for the live tees (point all three at the shared fleet Valkey db, or per-plane dbs):
ARB_EVAL_REDIS_URL=rediss://default:<pw>@<valkey-host>:25061/<eval-db>
ARB_TRACE_REDIS_URL=rediss://default:<pw>@<valkey-host>:25061/<transcript-db>
ARB_BRIDGE_BUS_URL=rediss://default:<pw>@<valkey-host>:25061/<events-live-db>
# Optional stream prefixes (leave blank unless you namespace streams):
ARB_EVAL_PREFIX=
ARB_TRACE_PREFIX=
ARB_BRIDGE_BUS_PREFIX=

# --- Bus-side claim gate reader (Slice 1c) ---
# Gate role used only by bridge admission reads. Provision separately; never use owner DSN here.
# Hand ARB_GATE_READER_DSN to seat supervisors' process/secret env — not the app-repo --env-file.
ARB_GATE_READER_ROLE=arb_gate_reader
ARB_GATE_READER_DSN=postgresql://arb_gate_reader:<pw>@<host>:25060/<db>?sslmode=require
# Fleet default OFF until Slice 1d supplies the exempt-lane writer. Canary may set 1 only after
# readiness checks pass.
BRIDGE_CLAIM_GATE=0

# --- Slice 1d-vi rollout prerequisites (Task 7) — process/secret env, not worker children ---
# Per-seat lane writer (one LOGIN role per seat + NOLOGIN function owner; operator-bound).
ARB_GATE_LANE_WRITER_ROLE=arb_gate_writer_<seat>
ARB_GATE_LANE_WRITER_DSN=postgresql://arb_gate_writer_<seat>:<pw>@<host>:25060/<db>?sslmode=require
# Server-side worktree lane: gated (default) or exempt.
BRIDGE_WORKTREE_LANE=gated
# Supervisor-owned nonblank vantage (blank registers empty — E25 forced-ordering defect).
BRIDGE_WORKER_VANTAGE=bridge-dev-mac
# Ref-required dual-accept → enforce. Keep 0 until ref-required checklist is green fleet-wide.
BRIDGE_TASK_REF_REQUIRED=0
# Local hydration credential (plist EnvironmentVariables / process env). Required for
# brief_hydrate=v1 advertisement via prove_brief_hydrate_readiness.
ARB_MEMORY_LOCAL_DSN=postgresql://arbmemory-reader:<pw>@<host>:25060/<db>?sslmode=require
# Local MCP tier flag (optional). When set, seat-preflight requires a resolvable local DSN.
# ARB_MEMORY_LOCAL_MCP=dev
# Optional: pin redis-capable interpreter when bare python3 on PATH lacks redis (E25(a)).
# BRIDGE_SUPERVISOR_PYTHON=/path/to/.venv/bin/python3
# Exempt lane (see README + docs/runbooks/exempt-seat-machine-user.md):
# BRIDGE_EXEMPT_GIT_SSH_COMMAND=ssh -i ~/.ssh/arb-exempt-bot -o IdentitiesOnly=yes
# BRIDGE_EXEMPT_GIT_KEY_FINGERPRINT=SHA256:...
# BRIDGE_EXEMPT_PROVISIONING_LEDGER=/path/to/ledger.json
# Target is always checkout origin — BRIDGE_EXEMPT_GIT_REMOTE_URL is not authoritative.
# Local compose overlay only (deploy/docker-compose.local.yml). No default: set a throwaway
# value, e.g. `openssl rand -hex 16`. Never reuse a real password here.
ARB_LOCAL_PG_PASSWORD=<throwaway-local-password>
