<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.arb.memory.retention</string>
  <key>ProgramArguments</key>
  <array><string>/bin/sh</string><string>/Users/<user>/<workspace>/deploy/retention-purge.sh</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>ARB_RETENTION_DSN</key><string>set-in-environment</string></dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>15</integer></dict>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
