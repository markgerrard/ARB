# Copy to .env, fill in, chmod 600. NEVER commit the filled copy.
# Key names mirror what buzz-relay actually reads (crates/buzz-relay/src/config.rs)
# and what upstream's deploy/compose/compose.yml expects.
#
# IMPORTANT: this file does NOT reach the container on its own. The overlay's
# `env_file: !reset` resolves to no env-file under Compose v5.x, so a key here
# only takes effect if compose.do.yml also maps it under `environment:`.
# Adding a key here and expecting the relay to read it fails silently.
# See README § "`.env` does NOT reach the container by itself".

# --- image ---------------------------------------------------------------
# Pin to a digest or immutable tag. Upstream's default is :main, which moves.
BUZZ_IMAGE=ghcr.io/block/buzz@sha256:

# --- DO Managed Postgres (LON) -------------------------------------------
# Use the PRIVATE-network host from the DO console; same region as the droplet
# so traffic stays off the public internet and off the egress meter.
# DO appends ?sslmode=require — keep it.
DATABASE_URL=
# Optional read replica. Leave EMPTY unless one exists.
READ_DATABASE_URL=
# Bounded staleness for replica reads. 0 disables replica routing entirely —
# setting READ_DATABASE_URL while leaving this 0 configures nothing.
BUZZ_REPLICA_READ_MAX_AGE_MS=0
# Must fit the managed cluster's connection cap (small on entry plans, and
# shared with psql/admin/migrations).
BUZZ_DB_POOL_SIZE=10
BUZZ_DB_READ_POOL_SIZE=5

# --- Object store: Cloudflare R2 ------------------------------------------
# NOT DO Spaces. Spaces has no If-Match compare-and-swap, so the relay's A3
# conformance probe fails and it exits at startup. See README § "Object store".
# Account-scoped endpoint => path addressing, region "auto".
BUZZ_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
BUZZ_S3_REGION=auto
BUZZ_S3_BUCKET=
BUZZ_S3_ACCESS_KEY=
BUZZ_S3_SECRET_KEY=
BUZZ_S3_ADDRESSING_STYLE=path
# The PUBLIC RELAY ORIGIN ending in /media — NOT the bucket URL. The relay
# proxies media itself (GET /media/{object}) and the bucket stays private.
# Point this at the bucket and uploads succeed while every link 404s.
BUZZ_MEDIA_BASE_URL=https://<public-relay-host>/media

# --- droplet-local redis --------------------------------------------------
REDIS_PASSWORD=

# --- relay ----------------------------------------------------------------
# NOTE the name: the relay reads RELAY_URL, NOT BUZZ_RELAY_URL. The startup
# error in main.rs:262 names BUZZ_RELAY_URL and is wrong (that one is read only
# by buzz-cli/acp/agent). Left at its ws://localhost:3000 default, the relay
# seeds a community for host "localhost:3000" and renders http:// media links.
RELAY_URL=wss://<public-relay-host>
# Mint with: buzz-admin generate-key. Without it the relay boots on a hardcoded
# DEV keypair whose pubkey is the secp256k1 generator point (private key = 1) —
# a world-known key that anyone can sign as. Back it up: a lost key orphans the
# relay identity, a leaked one is impersonatable in a signed log.
BUZZ_RELAY_PRIVATE_KEY=
# Host-bind the published port. Loopback-only when a tunnel fronts the relay:
# Docker's iptables rules bypass ufw, so the bind address is the control here,
# not a firewall rule.
BUZZ_HTTP_PORT=127.0.0.1:3000
BUZZ_AUTO_MIGRATE=false
# NOTE: inert unless mapped in compose.do.yml (see header).
RUST_LOG=info

# --- unused but required by upstream compose's ${VAR:?} guards -------------
# The postgres service is profiled out; these only satisfy interpolation.
POSTGRES_USER=unused
POSTGRES_PASSWORD=unused
POSTGRES_DB=unused
